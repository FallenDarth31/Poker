<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="HostingController">

    <Label layoutX="336.0" layoutY="14.0" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Hosting" />
    <TextArea fx:id="ServerIP" editable="false" layoutX="101.0" layoutY="100.0" prefHeight="66.0" prefWidth="262.0" />

    <Button fx:id="ConnectButton" layoutX="515.0" layoutY="100.0" mnemonicParsing="false" onAction="#Host" prefHeight="66.0" prefWidth="235.0" text="Begin Hosting">
      <font>
         <Font size="25.0" />
      </font>
   </Button>
   <TextArea fx:id="UsernameList" editable="false" layoutX="101.0" layoutY="244.0" prefHeight="301.0" prefWidth="196.0" />
   <TextField editable="false" layoutX="101.0" layoutY="210.0" prefHeight="26.0" prefWidth="196.0" text="Player List" AnchorPane.bottomAnchor="364.0" AnchorPane.leftAnchor="101.0" AnchorPane.rightAnchor="503.0" AnchorPane.topAnchor="210.0" />
   <Button layoutX="561.0" layoutY="391.0" mnemonicParsing="false" prefHeight="154.0" prefWidth="189.0" text="Start Game" textAlignment="CENTER" fx:id="StartGame" onAction="#StartGame">
      <font>
         <Font size="20.0" />
      </font>
   </Button>
   <MenuButton layoutX="637.0" layoutY="210.0" mnemonicParsing="false" text="MenuButton">
     <items>
       <MenuItem mnemonicParsing="false" text="Action 1" />
       <MenuItem mnemonicParsing="false" text="Action 2" />
     </items>
   </MenuButton>
   <TextField editable="false" layoutX="481.0" layoutY="210.0" prefHeight="26.0" prefWidth="152.0" text="Player Starting Money" />

</AnchorPane>
