<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.*?>

<AnchorPane prefHeight="700.0" prefWidth="1000.0"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="GameController">

    <!-- Community Cards Area (top center) -->
    <HBox layoutX="300" layoutY="150" spacing="10" alignment="CENTER">
        <ImageView fx:id="communityCard1" fitHeight="100" fitWidth="70" preserveRatio="true"/>
        <ImageView fx:id="communityCard2" fitHeight="100" fitWidth="70" preserveRatio="true"/>
        <ImageView fx:id="communityCard3" fitHeight="100" fitWidth="70" preserveRatio="true"/>
        <ImageView fx:id="communityCard4" fitHeight="100" fitWidth="70" preserveRatio="true"/>
        <ImageView fx:id="communityCard5" fitHeight="100" fitWidth="70" preserveRatio="true"/>
    </HBox>

    <!-- Pot Display (center) -->
    <VBox layoutX="450" layoutY="270" alignment="CENTER">
        <Label text="POT" style="-fx-font-size: 18px; -fx-font-weight: bold"/>
        <Label fx:id="potLabel" text="0" style="-fx-font-size: 24px"/>
    </VBox>

    <!-- Your Cards (bottom center) -->
    <HBox layoutX="400" layoutY="500" spacing="10" alignment="CENTER">
        <ImageView fx:id="playerCard1" fitHeight="120" fitWidth="80" preserveRatio="true"/>
        <ImageView fx:id="playerCard2" fitHeight="120" fitWidth="80" preserveRatio="true"/>
    </HBox>

    <!-- Your Info (bottom) -->
    <VBox layoutX="430" layoutY="630" alignment="CENTER">
        <Label fx:id="playerNameLabel" text="Your Name" style="-fx-font-size: 16px; -fx-font-weight: bold"/>
        <Label fx:id="playerChipsLabel" text="Chips: $1000" style="-fx-font-size: 14px"/>
    </VBox>

    <!-- Action Buttons (bottom right) -->
    <HBox layoutX="650" layoutY="580" spacing="10">
        <Button fx:id="foldButton" text="Fold" onAction="#handleFold" prefWidth="80"
                style="-fx-background-color: #ff4444; -fx-text-fill: white"/>
        <Button fx:id="checkButton" text="Check" onAction="#handleCheck" prefWidth="80"
                style="-fx-background-color: #44aa44; -fx-text-fill: white"/>
        <Button fx:id="callButton" text="Call" onAction="#handleCall" prefWidth="80"
                style="-fx-background-color: #4444ff; -fx-text-fill: white"/>
    </HBox>

    <!-- Raise Section (bottom right) -->
    <HBox layoutX="650" layoutY="630" spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="raiseAmountField" promptText="Amount" prefWidth="100"/>
        <Button fx:id="raiseButton" text="Raise" onAction="#handleRaise" prefWidth="80"
                style="-fx-background-color: #ff8800; -fx-text-fill: white"/>
    </HBox>

    <!-- Game Info (top left) -->
    <VBox layoutX="20" layoutY="20" spacing="5"
          style="-fx-background-color: #f0f0f0; -fx-padding: 10px; -fx-border-color: black">
        <Label text="Game Info" style="-fx-font-size: 16px; -fx-font-weight: bold"/>
        <Label fx:id="currentBetLabel" text="Current Bet: $0" style="-fx-font-size: 14px"/>
        <Label fx:id="phaseLabel" text="Phase: Waiting" style="-fx-font-size: 14px"/>
        <Label fx:id="turnLabel" text="Turn: -"
               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: red"/>
    </VBox>

    <!-- Other Players List (left side) -->
    <VBox layoutX="20" layoutY="200" spacing="10"
          style="-fx-background-color: #f0f0f0; -fx-padding: 10px; -fx-border-color: black">
        <Label text="Players:" style="-fx-font-size: 16px; -fx-font-weight: bold"/>
        <TextArea fx:id="playersListArea" prefHeight="300" prefWidth="200" editable="false"/>
    </VBox>

</AnchorPane>