<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="700.0" prefWidth="1000.0" style="-fx-background-color: linear-gradient(to bottom, #1a1a2e, #16213e);" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="LobbyController">
    <children>
        <VBox alignment="CENTER" spacing="50.0" AnchorPane.bottomAnchor="100.0" AnchorPane.leftAnchor="200.0" AnchorPane.rightAnchor="200.0" AnchorPane.topAnchor="100.0">
            <children>
                <!-- Title -->
                <Text fill="#00d9ff" fontSmoothingType="LCD" strokeType="OUTSIDE" strokeWidth="0.0" text="Game Lobby" textAlignment="CENTER">
                    <font>
                        <Font name="System Bold" size="56.0" />
                    </font>
                </Text>

                <!-- Waiting message with animation -->
                <HBox alignment="CENTER" spacing="20.0">
                    <children>
                        <Text fill="#ffffff" fontSmoothingType="LCD" strokeType="OUTSIDE" strokeWidth="0.0" text="Waiting for host to start game" textAlignment="CENTER">
                            <font>
                                <Font size="28.0" />
                            </font>
                        </Text>
                        <ProgressIndicator prefHeight="50.0" prefWidth="50.0" style="-fx-progress-color: #00d9ff;" />
                    </children>
                </HBox>

                <!-- Status message -->
                <Text fx:id="statusText" fill="#00ff88" fontSmoothingType="LCD" strokeType="OUTSIDE" strokeWidth="0.0" text="Connected to server" textAlignment="CENTER">
                    <font>
                        <Font size="22.0" />
                    </font>
                </Text>
            </children>
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>
        </VBox>
    </children>
</AnchorPane>