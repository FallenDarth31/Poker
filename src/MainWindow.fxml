<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="700.0" prefWidth="1000.0"
            style="-fx-background-color: linear-gradient(to bottom, #1a1a2e, #16213e);"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="HostingButtons">

    <children>
        <VBox alignment="CENTER" spacing="40.0" AnchorPane.bottomAnchor="100.0" AnchorPane.leftAnchor="250.0" AnchorPane.rightAnchor="250.0" AnchorPane.topAnchor="150.0">
            <children>
                <!-- Title -->
                <Text fill="#00d9ff" fontSmoothingType="LCD" strokeType="OUTSIDE" strokeWidth="0.0" text="Poker" textAlignment="CENTER">
                    <font>
                        <Font name="System Bold" size="72.0" />
                    </font>
                </Text>

                <!-- Host Game Button -->
                <Button mnemonicParsing="false" onAction="#handleHostGame" prefHeight="80.0" prefWidth="400.0"
                        style="-fx-background-color: #00d9ff; -fx-text-fill: #1a1a2e; -fx-background-radius: 15; -fx-font-weight: bold; -fx-font-size: 28px;"
                        text="Host Game">
                </Button>

                <!-- Join Game Button -->
                <Button mnemonicParsing="false" onAction="#handleJoinGame" prefHeight="80.0" prefWidth="400.0"
                        style="-fx-background-color: #00ff88; -fx-text-fill: #1a1a2e; -fx-background-radius: 15; -fx-font-weight: bold; -fx-font-size: 28px;"
                        text="Join Game">
                </Button>
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </VBox>
    </children>
</AnchorPane>