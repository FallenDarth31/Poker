<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ClientController">
   <children>
       <TextField fx:id="IPIn" layoutX="49.0" layoutY="130.0" />
      <TextArea layoutX="49.0" layoutY="39.0" prefHeight="81.0" prefWidth="333.0" text="If not using a using 192.168.0.XXX, then enter the first 3 sets of numbers your network IP in the form XXX.XXX.XXX i.e. (10.70.10)" wrapText="true" />
      <Button layoutX="216.0" layoutY="130.0" mnemonicParsing="false" onAction="#getIP" prefWidth="151.0" text="Set IP" />
      <Button layoutX="556.0" layoutY="39.0" mnemonicParsing="false" onAction="#TestConnection" prefHeight="184.0" prefWidth="206.0" text="Scan for Games" />
   </children>
</AnchorPane>
