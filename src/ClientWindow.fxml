<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ClientController">
   <children>
       <TextField fx:id="IPIn" layoutX="49.0" layoutY="197.0" />
      <TextArea editable="false" layoutX="49.0" layoutY="106.0" prefHeight="81.0" prefWidth="333.0" text="If the first 3 numbers are not the same as your server IP then set your own here" wrapText="true" />
      <Button layoutX="216.0" layoutY="197.0" mnemonicParsing="false" onAction="#getIP" prefWidth="151.0" text="Set IP" />
      <Button layoutX="556.0" layoutY="39.0" mnemonicParsing="false" onAction="#TestConnection" prefHeight="184.0" prefWidth="206.0" text="Scan for Games" />
      <TextArea fx:id="DeviceIPArea" editable="false" layoutX="50.0" layoutY="39.0" prefHeight="38.0" prefWidth="333.0" text="Device IP: ">
         <font>
            <Font size="20.0" />
         </font>
      </TextArea>
      <ComboBox fx:id="serverList" layoutX="49.0" layoutY="308.0" prefHeight="26.0" prefWidth="243.0" />
      <TextField editable="false" layoutX="49.0" layoutY="274.0" prefHeight="26.0" prefWidth="243.0" text="Select an IP" />
      <Button layoutX="556.0" layoutY="274.0" mnemonicParsing="false" prefHeight="81.0" prefWidth="206.0" text="Connect to Server"/>
   </children>
</AnchorPane>
