<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ClientController">
   <children>
       <TextField fx:id="IPIn" layoutX="44.0" layoutY="390.0" />
      <TextArea editable="false" layoutX="44.0" layoutY="299.0" prefHeight="81.0" prefWidth="333.0" text="If the first 3 numbers are not the same as your server IP then set your own here" wrapText="true" />
      <Button layoutX="211.0" layoutY="390.0" mnemonicParsing="false" onAction="#getIP" prefWidth="151.0" text="Set IP" />
      <Button layoutX="551.0" layoutY="232.0" mnemonicParsing="false" onAction="#TestConnection" prefHeight="184.0" prefWidth="206.0" text="Scan for Games" />
      <TextArea fx:id="DeviceIPArea" editable="false" layoutX="45.0" layoutY="232.0" prefHeight="38.0" prefWidth="333.0" text="Device IP: ">
         <font>
            <Font size="20.0" />
         </font>
      </TextArea>
      <ComboBox fx:id="serverList" layoutX="44.0" layoutY="501.0" prefHeight="26.0" prefWidth="243.0" />
      <TextField editable="false" layoutX="44.0" layoutY="467.0" prefHeight="26.0" prefWidth="243.0" text="Select an IP" />
      <Button layoutX="551.0" layoutY="467.0" mnemonicParsing="false" onAction="#Connect" prefHeight="81.0" prefWidth="206.0" text="Connect to Server"/>
      <TextField fx:id="UsernameIN" layoutX="44.0" layoutY="70.0" prefHeight="88.0" prefWidth="371.0" promptText="Enter Username:">
         <font>
            <Font size="18.0" />
         </font>
      </TextField>
   </children>
</AnchorPane>
